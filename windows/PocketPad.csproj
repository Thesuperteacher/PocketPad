<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>PocketPad</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="QRCoder" Version="1.6.0" /></ItemGroup>
  <!-- UI Automation loads these native WPF libraries from beside the executable. -->
  <Target Name="CopyDesktopNativeLibraries" AfterTargets="Publish">
    <ItemGroup>
      <DesktopNativeLibrary Include="@(RuntimePackAsset)" Condition="'%(RuntimePackAsset.AssetType)' == 'native' and '%(RuntimePackAsset.NuGetPackageId)' == 'Microsoft.WindowsDesktop.App.Runtime.win-x64'" />
    </ItemGroup>
    <Copy SourceFiles="@(DesktopNativeLibrary)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
